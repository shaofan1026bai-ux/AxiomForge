# Create the taskmanager user/group and /opt/task-manager with its virtualenv first.
[Unit]
Description=Python Task Manager
After=network.target

[Service]
Type=simple
User=taskmanager
Group=taskmanager
WorkingDirectory=/opt/task-manager
EnvironmentFile=-/etc/task-manager.env
ExecStart=/opt/task-manager/.venv/bin/python -m uvicorn app:app --host 0.0.0.0 --port 8090 --workers 1
Restart=on-failure
RestartSec=3
KillMode=mixed
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
